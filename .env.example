# Copy only when .env does not already exist. Never commit real credentials.
DATABASE_URL=sqlite:///data/research.db
CACHE_DIR=.cache/model-responses
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3
ANNOTATOR_MODEL=moonshotai/kimi-k3
REVIEWER_MODEL=z-ai/glm-5.3
MODEL_MAX_TOKENS=2048
nvidia_api_key=
# NVIDIA_API_KEY is also accepted; process environment overrides .env.
HF_TOKEN=
# hf_token is also accepted; process environment overrides .env.
HF_DATASET_REPO=
# Media bucket, separate from the versioned dataset repository (namespace/name).
HF_BUCKET=
BLOB_DIR=data/blobs
# Native Windows path also resolves through /mnt/<drive> in default WSL mounts.
BEAMNG_HOME=
BEAMNG_EDITION=drive
BEAMNG_HOST=127.0.0.1
BEAMNG_PORT=25252
BEAMNG_TIMEOUT=5
